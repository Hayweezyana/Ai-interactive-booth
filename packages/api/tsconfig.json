{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDirs": ["src", "../shared/src"],
    "outDir": "dist",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "@shared/prisma": ["../shared/src/generated/client"]
    },
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../shared" }
  ]
}
