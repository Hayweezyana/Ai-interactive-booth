{
"extends": "../../tsconfig.base.json",
"compilerOptions": {
"rootDir": "src",
"outDir": "dist",
"composite": true,
"module": "commonjs",
"target": "ES2020",
"declaration": true,
"moduleResolution": "node",
"baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "../../node_modules/*"]
    },
"esModuleInterop": true,
"skipLibCheck": true
},
"include": ["src/**/*"],
"exclude": ["node_modules", "dist", "prisma"]
}